---
// 답변이 HTML에 그대로 들어 있어야 검색엔진·AI가 읽을 수 있어서, JS 없이 details/summary로 만든다.
const { items } = Astro.props;
---
<section class="section" aria-labelledby="faq-title">
  <div class="wrap grid">
    <div>
      <span class="eyebrow">FAQ</span>
      <h2 class="sec-title" id="faq-title">자주 묻는 질문</h2>
    </div>
    <div class="list">
      {items.map((f, i) => (
        <details data-reveal style={`--i:${i}`} open={i === 0}>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
<style>
  .grid { display: grid; grid-template-columns: 1fr 1.6fr; gap: clamp(24px, 6vw, 96px); align-items: start; }
  details { border-top: 1px solid var(--line); }
  details:last-child { border-bottom: 1px solid var(--line); }
  summary { cursor: pointer; list-style: none; padding: 22px 40px 22px 0; font-weight: 500; font-size: clamp(16px, 1.6vw, 18px); position: relative; }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: '+'; position: absolute; right: 4px; top: 50%; translate: 0 -50%; font-size: 24px; font-weight: 300; transition: rotate .3s var(--ease); }
  details[open] summary::after { rotate: 45deg; }
  details p { padding: 0 0 24px; color: var(--muted); max-width: 40em; }
  @media (max-width: 767px) { .grid { grid-template-columns: 1fr; } }
</style>
