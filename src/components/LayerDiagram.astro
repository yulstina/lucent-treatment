---
const { layers, note } = Astro.props;
---
<section class="section dark" aria-labelledby="principle-title">
  <div class="wrap grid">
    <div>
      <span class="eyebrow">How it works</span>
      <h2 class="sec-title" id="principle-title">피부 겉이 아닌,<br />깊은 층에 집중합니다</h2>
      <p class="note">{note}</p>
    </div>
    <div class="diagram" role="img" aria-label="피부 층 단면: 표피, 진피, 근막층(초음파 에너지가 모이는 층), 지방·근육 순서">
      <div class="beam" aria-hidden="true"></div>  {/* beam이 첫 div라 .layer는 nth-of-type 2번부터 */}
      {layers.map((l, i) => (
        <div class:list={['layer', { target: l.target }]} data-reveal style={`--i:${i}`}>
          <span>{l.name} <em>{l.en}</em></span><span class="desc">{l.desc}</span>
        </div>
      ))}
    </div>
  </div>
</section>
<style>
  .dark { background: var(--ink); color: #fff; }
  .dark :global(.eyebrow) { color: #9fb0ba; }
  .grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(24px, 6vw, 96px); align-items: center; }
  .note { color: #9fb0ba; font-size: 14px; max-width: 26em; }
  .diagram { position: relative; border-radius: var(--radius); overflow: hidden; }
  .layer { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 28px 24px; font-size: 16px; position: relative; }
  .layer em { font: 400 13px var(--font-en); letter-spacing: .08em; margin-left: 6px; }
  .desc { font-size: 13px; text-align: right; }
  .layer:nth-of-type(2) { background: #f3d9cf; color: #3d2a24; }
  .layer:nth-of-type(3) { background: #e8bfb1; color: #3d2a24; }
  .layer:nth-of-type(4) { background: #8f6459; color: #fff; }
  .layer:nth-of-type(5) { background: #6f4a42; color: #fff; }
  .layer.target::after { content: ''; position: absolute; left: 50%; top: 50%; width: 14px; height: 14px; margin: -7px; border-radius: 50%; background: #fff; box-shadow: 0 0 0 0 rgb(159 211 255 / .8); animation: pulse 2.2s ease-out infinite; }
  /* 초음파 빔: 위에서 아래로 내려와 근막층에서 멈춘다. */
  .beam { position: absolute; left: 50%; top: 0; width: 3px; height: 0; transform: translateX(-50%); z-index: 2;
    background: linear-gradient(#e6f3ff, #9fd3ff); box-shadow: 0 0 16px #9fd3ff; border-radius: 2px;
    animation: beam 3.2s var(--ease) infinite; }
  @keyframes beam { 0% { height: 0; opacity: 0; } 12% { opacity: 1; } 55%, 85% { height: 62%; opacity: 1; } 100% { height: 62%; opacity: 0; } }
  @keyframes pulse { 0%, 45% { box-shadow: 0 0 0 0 rgb(159 211 255 / .9); } 100% { box-shadow: 0 0 0 36px rgb(159 211 255 / 0); } }
  @media (max-width: 767px) { .grid { grid-template-columns: 1fr; } .layer { padding: 22px 18px; } }
</style>
